FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-local-dev-secret
DATABASE_URL=sqlite:///instance/ecobridge_dev.db
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH=4194304

MAIL_SERVER=smtp.example.com
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USE_TLS=false
MAIL_USERNAME=demo@example.com
MAIL_PASSWORD=change-me
MAIL_DEFAULT_SENDER=demo@example.com
CONTACT_RECIPIENT=admin@example.com
MAIL_TIMEOUT=30
MAIL_SUPPRESS_SEND=false

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-use
ADMIN_PHONE=+233000000000
